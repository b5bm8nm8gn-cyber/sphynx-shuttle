---
export const prerender = false;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Publier · Sphynx Shuttle</title>
<style is:global>
:root{--bg:#fff;--surface:#fff;--surface2:#F5F5F7;--surface3:#E8E8ED;--ink:#1D1D1F;--ink2:#6E6E73;--ink3:#AEAEB2;--line:rgba(0,0,0,.1);--line2:rgba(0,0,0,.06);--btn:#1D1D1F;--btn-ink:#fff;--ok:#248A3D;--err:#D70015;--ring:rgba(29,29,31,.14);color-scheme:light}
@media (prefers-color-scheme:dark){:root{--bg:#000;--surface:#151517;--surface2:#1C1C1E;--surface3:#2C2C2E;--ink:#F5F5F7;--ink2:#A1A1A6;--ink3:#6E6E73;--line:rgba(255,255,255,.12);--line2:rgba(255,255,255,.07);--btn:#F5F5F7;--btn-ink:#000;--ok:#30D158;--err:#FF453A;--ring:rgba(245,245,247,.18);color-scheme:dark}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 -apple-system,BlinkMacSystemFont,"SF Pro Text",Inter,"Helvetica Neue",Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}
a{color:inherit}
[hidden]{display:none!important}
.top{position:sticky;top:0;z-index:5;height:60px;display:flex;align-items:center;gap:16px;padding:0 28px;background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:saturate(180%) blur(18px);border-bottom:1px solid var(--line2)}
.top img{height:18px;display:block}
@media (prefers-color-scheme:dark){.top img{filter:invert(1)}}
.top .sp{margin-left:auto;display:flex;gap:8px}
.wrap{max-width:860px;margin:0 auto;padding:48px 28px 120px}
.eyebrow{margin:0;font-size:12px;font-weight:500;letter-spacing:.09em;text-transform:uppercase;color:var(--ink2)}
h1{margin:10px 0 12px;font-size:40px;line-height:1.08;letter-spacing:-.02em;font-weight:600}
h2{margin:0 0 14px;font-size:21px;letter-spacing:-.015em;font-weight:600}
.lede{margin:0;color:var(--ink2);font-size:17px;max-width:60ch}
.card{margin-top:36px;padding:24px;border-radius:22px;background:var(--surface2)}
.drop{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:170px;padding:24px;border:1.5px dashed var(--line);border-radius:18px;background:var(--surface);text-align:center;cursor:pointer;transition:border-color .15s,background-color .15s}
.drop:hover,.drop.is-over{border-color:var(--ink);background:var(--surface)}
.drop b{font-size:17px;font-weight:600;letter-spacing:-.01em}
.drop span{color:var(--ink2);font-size:14px}
.file{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:14px;background:var(--surface);margin-top:12px}
.file b{font-weight:600}.file span{color:var(--ink2);font-size:13px;margin-left:auto}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}
.grid .full{grid-column:1/-1}
label{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:500;color:var(--ink2)}
input,textarea,select{font:inherit;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:0 14px;height:44px;width:100%}
textarea{height:auto;min-height:84px;padding:10px 14px;resize:vertical;line-height:1.4}
input:focus,textarea:focus,select:focus{outline:0;border-color:var(--ink);box-shadow:0 0 0 4px var(--ring)}
.note{margin:14px 0 0;font-size:13px;color:var(--ink2)}
.note.is-update{color:var(--ink)}
.actions{display:flex;align-items:center;gap:14px;margin-top:20px}
.btn{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 22px;border-radius:980px;border:0;background:var(--btn);color:var(--btn-ink);font:inherit;font-weight:500;cursor:pointer;text-decoration:none;white-space:nowrap}
.btn[disabled]{opacity:.45;cursor:default}
.btn-ghost{background:transparent;color:var(--ink2);height:34px;padding:0 14px;font-size:13px}
.btn-ghost:hover{background:var(--surface2);color:var(--ink)}
.msg{font-size:14px}.msg.ok{color:var(--ok)}.msg.err{color:var(--err)}
.list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}
.item{display:grid;grid-template-columns:1fr auto;gap:6px 16px;align-items:center;padding:16px 18px;border-radius:16px;background:var(--surface)}
.item .t{font-weight:600;letter-spacing:-.01em}
.item .m{grid-column:1;font-size:13px;color:var(--ink2)}
.item .a{grid-column:2;grid-row:1/3;display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.item.is-hidden{opacity:.55}
.gate{max-width:380px;margin:12vh auto 0;padding:0 24px;text-align:center}
.gate form{display:flex;flex-direction:column;gap:12px;margin-top:28px}
.gate input{text-align:center;letter-spacing:.08em}
@media (max-width:640px){.wrap{padding:32px 18px 96px}.top{padding:0 18px}.grid{grid-template-columns:1fr}h1{font-size:32px}.item{grid-template-columns:1fr}.item .a{grid-column:1;grid-row:auto;justify-content:flex-start}}
</style>
</head>
<body>
<header class="top">
  <a href="/" aria-label="Retour à l’espace client"><img src={base + "sphynx-wordmark.svg"} alt="sphynx"></a>
  <span style="color:var(--ink2);font-size:14px">Publication</span>
  <div class="sp"><a class="btn btn-ghost" href="/">Espace client</a><button class="btn btn-ghost" id="logout" hidden>Quitter</button></div>
</header>

<section class="gate" id="gate" hidden>
  <p class="eyebrow">Sphynx Shuttle</p>
  <h1>Publication</h1>
  <p class="lede" style="margin:0 auto">Réservé à Sphynx Studio. Entrez le code administrateur.</p>
  <form id="gate-form">
    <input id="gate-pass" type="password" placeholder="Code administrateur" autocomplete="current-password" required>
    <button class="btn" type="submit">Entrer</button>
    <p class="msg err" id="gate-err" hidden></p>
  </form>
</section>

<main class="wrap" id="app" hidden>
  <p class="eyebrow">Sphynx Shuttle · Sopht</p>
  <h1>Publier un document</h1>
  <p class="lede">Déposez une page HTML : elle est en ligne dans l’espace client dès que vous cliquez sur Publier. Un document qui porte le même nom est remplacé par la nouvelle version, et son fil de commentaires est conservé.</p>

  <section class="card">
    <label class="drop" id="drop" for="file">
      <b>Déposez le fichier HTML ici</b>
      <span>ou cliquez pour le choisir</span>
      <input id="file" type="file" accept=".html,.htm,text/html" hidden>
    </label>
    <div class="file" id="file-info" hidden><b id="file-name"></b><span id="file-size"></span></div>

    <form id="pub" hidden>
      <div class="grid">
        <label class="full">Publier comme
          <select id="target"></select>
        </label>
        <label class="full">Titre<input id="title" required maxlength="160"></label>
        <label>Type<input id="kind" list="kinds" maxlength="60" placeholder="Preuve de concept"></label>
        <label>Version<input id="version" maxlength="30" placeholder="v0.54"></label>
        <label class="full">Résumé (facultatif)<textarea id="summary" maxlength="600" placeholder="Une ou deux phrases affichées dans la bibliothèque"></textarea></label>
      </div>
      <datalist id="kinds"><option>Preuve de concept</option><option>Design system</option><option>Spécification</option><option>Note</option></datalist>
      <p class="note" id="note"></p>
      <div class="actions"><button class="btn" id="publish" type="submit">Publier</button><span class="msg" id="pub-msg"></span></div>
    </form>
  </section>

  <section class="card">
    <h2>Documents en ligne</h2>
    <ul class="list" id="list"></ul>
  </section>
</main>

<script define:vars={{ base }}>
const API = base + 'api';
const $ = (s) => document.querySelector(s);
const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const fmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
const slugify = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80);
let docs = [], file = null;

async function api(path, opts = {}) {
  const r = await fetch(API + path, { cache: 'no-store', credentials: 'same-origin', ...opts });
  const j = await r.json().catch(() => ({}));
  if (!r.ok) throw Object.assign(new Error(j.error || 'Erreur ' + r.status), { status: r.status });
  return j;
}

async function start() {
  try {
    const s = await api('/session');
    if (!s.admin) throw new Error();
    $('#gate').hidden = true; $('#app').hidden = false; $('#logout').hidden = false;
    await refresh();
  } catch { $('#gate').hidden = false; $('#app').hidden = true; setTimeout(() => $('#gate-pass').focus(), 50); }
}
$('#gate-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  try {
    const r = await api('/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: $('#gate-pass').value }) });
    if (!r.admin) throw new Error('Ce mot de passe ouvre l’espace client, pas la publication.');
    $('#gate-pass').value = ''; start();
  } catch (err) { $('#gate-err').textContent = err.message; $('#gate-err').hidden = false; }
});
$('#logout').addEventListener('click', async () => { await api('/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }).catch(() => {}); location.href = '/'; });

async function refresh() {
  docs = (await api('/docs?all=1')).docs;
  $('#list').innerHTML = docs.length ? docs.map((d) => `<li class="item${d.hidden ? ' is-hidden' : ''}">
      <span class="t">${esc(d.title)}</span>
      <span class="m">${[d.version, d.kind].filter(Boolean).map(esc).join(' · ')} · mis à jour le ${fmt.format(new Date(d.updated_at))} · ${d.comments ? d.comments + ' commentaire' + (d.comments > 1 ? 's' : '') + (d.resolved ? ', dont ' + d.resolved + ' validé' + (d.resolved > 1 ? 's' : '') : '') : 'aucun commentaire'}${d.hidden ? ' · masqué' : ''}</span>
      <span class="a"><a class="btn btn-ghost" href="/document?d=${encodeURIComponent(d.slug)}" target="_blank" rel="noopener">Ouvrir</a>
      <button class="btn btn-ghost" data-act="${d.hidden ? 'show' : 'hide'}" data-slug="${esc(d.slug)}">${d.hidden ? 'Afficher' : 'Masquer'}</button>
      <button class="btn btn-ghost" data-act="del" data-slug="${esc(d.slug)}">Supprimer</button></span></li>`).join('')
    : '<li class="note">Aucun document pour l’instant.</li>';
  fillTargets();
}
$('#list').addEventListener('click', async (e) => {
  const b = e.target.closest('button[data-act]'); if (!b) return;
  const slug = b.dataset.slug, d = docs.find((x) => x.slug === slug);
  if (b.dataset.act === 'del') {
    if (!confirm(`Supprimer « ${d.title} » de l’espace client ? Les commentaires restent archivés.`)) return;
    await api('/admin/docs/' + slug, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
  } else {
    await api('/admin/docs/' + slug, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ hidden: b.dataset.act === 'hide' }) });
  }
  refresh();
});

function fillTargets(selected) {
  const sel = $('#target'); const cur = selected ?? sel.value;
  sel.innerHTML = '<option value="">Nouveau document</option>' + docs.map((d) => `<option value="${esc(d.slug)}">Nouvelle version de « ${esc(d.title)} »</option>`).join('');
  if (cur !== undefined) sel.value = docs.some((d) => d.slug === cur) ? cur : '';
}
function updateNote() {
  const t = $('#target').value, d = docs.find((x) => x.slug === t);
  $('#note').className = 'note' + (d ? ' is-update' : '');
  $('#note').textContent = d ? `Remplace « ${d.title} » ${d.version ? '(' + d.version + ') ' : ''}: même adresse, fil de commentaires conservé.` : 'Sera ajouté en tête de la bibliothèque.';
}
$('#target').addEventListener('change', () => {
  const d = docs.find((x) => x.slug === $('#target').value);
  if (d) { $('#title').value = d.title; if (!$('#kind').value) $('#kind').value = d.kind || ''; if (!$('#summary').value) $('#summary').value = d.summary || ''; }
  updateNote();
});

async function pick(f) {
  if (!f) return;
  if (!/\.html?$/i.test(f.name)) { alert('Choisissez un fichier .html'); return; }
  file = f;
  $('#file-name').textContent = f.name; $('#file-size').textContent = (f.size / 1024 / 1024).toFixed(2).replace('.', ',') + ' Mo';
  $('#file-info').hidden = false; $('#pub').hidden = false; $('#pub-msg').textContent = '';
  const text = await f.text();
  const raw = ((text.match(/<title[^>]*>([\s\S]*?)<\/title>/i) || [])[1] || f.name.replace(/\.html?$/i, '')).replace(/\s+/g, ' ').trim();
  const vm = raw.match(/\bv\s?\d+(?:[.,]\d+)*\b/i) || f.name.match(/\bv\d+(?:[.\-_]\d+)*\b/i);
  const version = vm ? vm[0].replace(/\s/g, '').replace(/[-_,]/g, '.').toLowerCase() : '';
  const title = raw.replace(/\bv\s?\d+(?:[.,]\d+)*\b/i, '').replace(/[\s·\-–:|]+$/, '').replace(/\s{2,}/g, ' ').trim() || raw;
  $('#title').value = title; $('#version').value = version; $('#kind').value = ''; $('#summary').value = '';
  const match = docs.find((d) => d.slug === slugify(title)) || docs.find((d) => slugify(d.title) === slugify(title));
  fillTargets(match ? match.slug : '');
  if (match) { $('#kind').value = match.kind || ''; $('#summary').value = match.summary || ''; }
  updateNote();
  $('#title').focus();
}
$('#file').addEventListener('change', (e) => pick(e.target.files[0]));
const drop = $('#drop');
['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('is-over'); }));
['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.remove('is-over'); }));
drop.addEventListener('drop', (e) => pick(e.dataTransfer.files[0]));

$('#pub').addEventListener('submit', async (e) => {
  e.preventDefault(); if (!file) return;
  const qs = new URLSearchParams({ title: $('#title').value, kind: $('#kind').value, version: $('#version').value, summary: $('#summary').value, name: file.name });
  if ($('#target').value) qs.set('slug', $('#target').value);
  $('#publish').disabled = true; $('#pub-msg').className = 'msg'; $('#pub-msg').textContent = 'Publication…';
  try {
    const r = await api('/admin/docs?' + qs.toString(), { method: 'POST', headers: { 'Content-Type': 'application/octet-stream' }, body: file });
    $('#pub-msg').className = 'msg ok';
    $('#pub-msg').innerHTML = `${r.updated ? 'Nouvelle version publiée' : 'Document publié'}. <a href="/document?d=${encodeURIComponent(r.doc.slug)}" target="_blank" rel="noopener">Voir dans l’espace client</a>`;
    file = null; $('#file').value = ''; $('#file-info').hidden = true;
    await refresh();
  } catch (err) { $('#pub-msg').className = 'msg err'; $('#pub-msg').textContent = err.message; }
  finally { $('#publish').disabled = false; }
});
start();
</script>
</body>
</html>
