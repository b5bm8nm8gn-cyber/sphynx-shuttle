---
const { title = "Sphynx Shuttle" } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <style is:global>
      :root{color-scheme:light dark;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Inter","Helvetica Neue",Helvetica,Arial,sans-serif}
      body{margin:0;min-height:100dvh;display:grid;place-items:center;background:#fff;color:#1D1D1F;-webkit-font-smoothing:antialiased}
      @media (prefers-color-scheme:dark){body{background:#000;color:#F5F5F7}}
    </style>
  </head>
  <body><slot /></body>
</html>
